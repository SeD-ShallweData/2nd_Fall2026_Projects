# Public example only. Put real values outside the repository.
LLM_PROVIDER=upstage
LLM_MODEL=solar-pro4
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_ALLOWED_HOSTS=api.upstage.ai
ROA_ENABLE_LLM=0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1800
LLM_MAX_REQUESTS_PER_MINUTE=12
LLM_MAX_REQUESTS_PER_PROCESS=120
# UPSTAGE_API_KEY=SET_IN_PRIVATE_SERVER_ENV
# LLM_ENV_FILE=SET_PRIVATE_FILE_PATH
# CLI --allow-http-authenticated is a local administrative exception only.
